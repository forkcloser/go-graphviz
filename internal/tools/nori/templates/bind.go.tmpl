func (m *WasmModule) toObjectArrayWasmValue(ctx context.Context, v any) (uint64, error) {
	ret, err := m.malloc(ctx, 4+4) // GoSlice
	if err != nil {
		return 0, err
	}
	rv := reflect.ValueOf(v)
	if err := m.writeU32(ctx, ret, uint32(rv.Len())); err != nil {
		return 0, err
	}
	data, err := m.malloc(ctx, uint64(8*rv.Len()))
	if err != nil {
		return 0, err
	}
	if err := m.writeU32(ctx, ret+4, uint32(data)); err != nil {
		return 0, err
	}
	ptr := data
	for i := 0; i < rv.Len(); i++ {
		vv := rv.Index(i).Interface().(wasmStruct)
		if err := m.writeU32(ctx, ptr, uint32(vv.getPtr())); err != nil {
			return 0, err
		}
		ptr += 8
	}
	return ret, nil
}

