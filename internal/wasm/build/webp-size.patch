+    us->w = (int)(bits & 0x3fff) + 1;
+    us->h = (int)((bits >> 14) & 0x3fff) + 1;
+    break;
   }
+  case 'X': // VP8X: canvas width-1 and height-1, 24 bits each, at 24 and 27
+    us->w = (int)(b[24] | b[25] << 8 | b[26] << 16) + 1;
+    us->h = (int)(b[27] | b[28] << 8 | b[29] << 16) + 1;
+    break;
+  default: // VP8: width and height, 14 bits each above two scale bits, at 26 and 28
