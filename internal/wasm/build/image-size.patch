 static Dict_t *ImageDict;
 
+// go-graphviz: an image is sized once a layout, where it was once for as
+// long as the process lives: a file that changes is sized again. Layouts
+// are counted, and each image keeps the count it was sized at.
+static unsigned ImageLayout;
+
 typedef struct {
+  usershape_t us; // first: a sized_t is handed about as its usershape_t
+  unsigned layout;
+} sized_t;
+
+void gvusershape_layout_begins(void) { ImageLayout++; }
+
+typedef struct {
   char *template;
   size_t size;
   imagetype_t type;
@@ -769,8 +781,18 @@
